# Shared by the Android and iOS apps: CI passes APP_ID with -e
appId: ${APP_ID}
---
- launchApp:
    clearState: true

- assertVisible: "No saved stops yet"

# Routes and bus positions come from live APIs, so allow for a slow network
- tapOn: "Routes"
# 60s: the first request can land on a Cloud Run cold start, and the app retries a request that
# times out (20s) — 30s wasn't always enough on CI
- extendedWaitUntil:
    visible: "Seacrest - Eyre Square - Merlin Park"
    timeout: 60000
- tapOn: "Seacrest - Eyre Square - Merlin Park"

- extendedWaitUntil:
    visible: "Route 402"
    timeout: 30000
- extendedWaitUntil:
    visible: "Updated.*"
    timeout: 30000
# The text is up before the map has drawn its tiles and markers; wait for the map's first full
# render (Android exposes it as "Map loaded") and for the camera to settle on the route.
- runFlow:
    when:
      platform: Android
    commands:
      - extendedWaitUntil:
          visible: "Map loaded"
          timeout: 30000
- waitForAnimationToEnd:
    timeout: 5000
- takeScreenshot: GalwayBus
# Still showing after the map has had time to render (a crash there would otherwise go unnoticed)
- waitForAnimationToEnd:
    timeout: 5000
- assertVisible: "Route 402"
